<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="@dimen/luoyang_temp_card_width"
        android:layout_height="@dimen/luoyang_temp_card_height"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/luoyang_pass_temp_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/luoyang_temp_title_margin_top"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:text="@string/luoyang_temp_pass_title"
                android:textColor="@color/luoyang_temp_title_red"
                android:textSize="@dimen/luoyang_temp_title_text_size"
                android:letterSpacing="0.2"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/luoyang_temp_photo_height"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:weightSum="8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_id_code"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/idCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_name"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/passers_by"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_area"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/access_area"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_unit"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/unit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_escort"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/lead_people1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_escort_id"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/lead_people1_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_escort_unit"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/leading_person_unit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingBottom="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:text="@string/luoyang_temp_label_validity"
                            android:textColor="@color/luoyang_temp_label"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/expiryDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/luoyang_temp_field_underline"
                            android:ellipsize="end"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/color_black"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/luoyang_temp_photo_width"
                    android:layout_height="@dimen/luoyang_temp_photo_height"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/luoyang_temp_photo_frame"
                    android:padding="1dp">

                    <ImageView
                        android:id="@+id/card_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/or_code"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_color"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lead_people2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/faceSimilarLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/faceSimilar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/statusOverlay"
            android:layout_width="120dp"
            android:layout_height="105dp"
            android:layout_gravity="bottom|end"
            android:rotation="-30"
            android:visibility="gone">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_seal" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
