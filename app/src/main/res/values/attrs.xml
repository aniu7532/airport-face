<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="title" format="string" />
    <attr name="placeholder" format="string" />
    <declare-styleable name="ConstructionWorkersInput">
        <attr name="title" />
        <attr name="placeholder" />
    </declare-styleable>
    <declare-styleable name="ConstructionWorkersSelector">
        <attr name="title" />
        <attr name="placeholder" />
    </declare-styleable>
    <declare-styleable name="ConstructionWorkersTimeSelector">
        <attr name="withoutHMS" format="boolean" />
        <!-- 仅选到小时（显示时、分秒滚轮隐藏）；与 withoutHMS 互斥，withoutHMS 优先 -->
        <attr name="hourOnly" format="boolean" />
        <!-- hourOnly 时：结束时间对齐到该小时 59 分 59 秒 -->
        <attr name="snapToEndOfHour" format="boolean" />
    </declare-styleable>
    <declare-styleable name="ConstructionWorkersCompanyAutoComplete">
        <attr name="title" />
        <attr name="placeholder" />
    </declare-styleable>
</resources>